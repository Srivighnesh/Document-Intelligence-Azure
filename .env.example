# Only non-secret local configuration belongs here.
AZURE_KEY_VAULT_URL=https://<vault-name>.vault.azure.net/
AZURE_STORAGE_CONTAINER_NAME=<existing-container>
DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-layout
FOUNDRY_AGENT_NAME=<agent-name>
FOUNDRY_AGENT_VERSION=1
FOUNDRY_MAX_OCR_CHARS=1500
FOUNDRY_REQUESTED_FIELDS=companyName,commissionFileNumber,reportingPeriodEndDate,incorporationState,companyAddress,telephoneNumber,tickerSymbols,exchangeNames

# Optional Key Vault secret name override.
DOCUMENT_INTELLIGENCE_KEY_SECRET_NAME=DocumentIntelligenceKey
